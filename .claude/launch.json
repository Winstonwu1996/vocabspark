{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vocabspark",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npm run dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vocabspark-prod",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npm run start -- -p 3100"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
